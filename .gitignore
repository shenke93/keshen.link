# ==============================================================================
# 🌌 Ke Shen's Personal Website - .gitignore
# Designed with the 'less is more' philosophy.
# ==============================================================================

# --- Hugo Builds & Temporary Files ---
/public/
/resources/_gen/
/.hugo_build.lock
hugo_stats.json

# --- Submodules & Dependencies ---
/node_modules/
/assets/jsconfig.json
*.log
.eslintcache

# --- AI & Agent Tooling ---
.agents/

# --- OS Specific Junk ---
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
*.stackdump

# --- IDEs & Local Configurations ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?